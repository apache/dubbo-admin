{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dubbo-admin.ai/schema/agent.schema.json",
  "title": "Agent Component Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "spec"],
  "properties": {
    "type": {
      "const": "agent"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "prompt_base_path"],
      "properties": {
        "conversation_summary": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "model": { "type": "string", "maxLength": 256 },
            "context_tokens": { "type": "integer", "minimum": 1 },
            "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300, "default": 10 },
            "max_calls": { "type": "integer", "minimum": 1, "maximum": 32, "default": 2 },
            "recovery_max_calls": { "type": "integer", "minimum": 1, "maximum": 64, "default": 8 },
            "fragment_bytes": { "type": "integer", "minimum": 256, "maximum": 65536, "default": 8192 },
            "max_output_bytes": { "type": "integer", "minimum": 256, "maximum": 65536, "default": 8192 },
            "output_tokens": { "type": "integer", "minimum": 1, "default": 2048 },
            "trigger_headroom_turns": { "type": "integer", "minimum": 1, "default": 2 }
          }
        },
        "context_compiler_mode": {
          "type": "string", "enum": ["enabled", "minimal"], "default": "enabled",
          "description": "minimal keeps mandatory compiler security/budgets while disabling history and tools."
        },
        "context_tokens": { "type": "integer", "minimum": 1, "default": 32768 },
        "context_safety_margin": { "type": "integer", "minimum": 1, "default": 1024 },
        "max_context_bytes": { "type": "integer", "minimum": 1, "default": 8388608 },
        "max_collect_bytes": { "type": "integer", "minimum": 1, "default": 8388608 },
        "template_id": { "type": "string", "minLength": 1, "maxLength": 64, "default": "react" },
        "template_version": { "type": "string", "minLength": 1, "maxLength": 32, "default": "1" },
        "template_variables": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 4096 } },
        "template_archive_files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "allowed_tools": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "tool_required_scopes": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "agent_type": {
          "type": "string",
          "default": "react",
          "enum": ["react"]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "default": "qwen-max"
        },
        "prompt_base_path": {
          "type": "string",
          "minLength": 1,
          "default": "./prompts"
        },
        "prompt_file": {
          "type": "string",
          "minLength": 1,
          "default": "agentReasonAct.txt"
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "channel_buffer_size": {
          "type": "integer",
          "minimum": 1,
          "default": 5
        },
        "context_window_turns": {
          "type": "integer",
          "minimum": 1,
          "default": 10,
          "description": "Maximum number of completed turns included before the current active turn."
        },
        "tool_timeouts": {
          "type": "object",
          "description": "Per-tool execution timeout overrides in seconds, keyed by tool name. Tools without an entry use the built-in 30s default.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 0.7
        },
        "top_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.9
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "default": 3000
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "default": 90
        }
      }
    }
  }
}
