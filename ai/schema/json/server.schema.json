{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dubbo-admin.ai/schema/server.schema.json",
  "title": "Server Component Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "spec"],
  "properties": {
    "type": {
      "const": "server"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory_projects": {
          "type": "array", "default": [], "maxItems": 1000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "tenant_id", "owner_ids"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 128 },
              "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
              "owner_ids": { "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }
            }
          }
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 8888
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "default": "127.0.0.1"
        },
        "debug": {
          "type": "boolean",
          "default": false
        },
        "cors_origins": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "read_timeout": {
          "type": "integer",
          "minimum": 1,
          "default": 30
        },
        "write_timeout": {
          "type": "integer",
          "minimum": 1,
          "default": 30
        },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "production_auth": {
              "type": "boolean",
              "default": false
            },
            "usage_persistence": {
              "type": "boolean",
              "default": true
            },
            "audit_events": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "default": {
            "tenant_id": "default",
            "user_id": "local-user",
            "roles": ["user"],
            "scopes": [],
            "allow_insecure_static_auth": false,
            "adopt_legacy_sessions": false,
            "enabled": false
          },
          "properties": {
            "tenant_id": {
              "type": "string",
              "minLength": 1,
              "default": "default"
            },
            "user_id": {
              "type": "string",
              "minLength": 1,
              "default": "local-user"
            },
            "roles": {
              "type": "array",
              "default": ["user"],
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            },
            "scopes": {
              "type": "array",
              "default": [],
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            },
            "allow_insecure_static_auth": {
              "type": "boolean",
              "default": false,
              "description": "Permit development-only static authentication on a non-loopback listener."
            },
            "adopt_legacy_sessions": {
              "type": "boolean",
              "default": false,
              "description": "Run the one-time migration for sessions where both tenant and owner are absent."
            },
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "jwks_url": {
              "type": "string",
              "pattern": "^https?://"
            },
            "issuer": {
              "type": "string",
              "minLength": 1
            },
            "audience": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {"enabled": {"const": true}},
                "required": ["enabled"]
              },
              "then": {
                "required": ["jwks_url", "issuer", "audience"]
              }
            }
          ]
        }
      }
    }
  }
}
