{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dubbo-admin.ai/schema/main.schema.json",
  "title": "Dubbo Admin AI Main Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "version", "components"],
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
