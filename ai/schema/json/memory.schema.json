{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dubbo-admin.ai/schema/memory.schema.json",
  "title": "Memory Component Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "spec"],
  "properties": {
    "type": {
      "const": "memory"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {
          "type": "string",
          "enum": ["memory", "gorm"],
          "default": "memory"
        },
        "history_key": {
          "type": "string",
          "enum": ["chat_history", "system_memory", "core_memory"],
          "default": "chat_history"
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "default": 100
        },
		"quota": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"max_sessions_per_tenant": {"type": "integer", "minimum": 1, "default": 1000},
			"max_events_per_turn": {"type": "integer", "minimum": 1, "default": 1000},
			"max_session_bytes": {"type": "integer", "minimum": 1, "default": 10485760},
			"max_tenant_bytes": {"type": "integer", "minimum": 1, "default": 1073741824},
			"max_in_memory_entities": {"type": "integer", "minimum": 1, "default": 100000, "description": "Maximum conversation entities retained by the in-process memory backend; ignored by the gorm backend"}
		  }
		},
		"lifecycle": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"retention_seconds": {"type": "integer", "minimum": 1, "default": 86400},
			"cleanup_interval_seconds": {"type": "integer", "minimum": 1, "default": 3600},
			"cleanup_batch_size": {"type": "integer", "minimum": 1, "default": 100},
			"interaction_lease_seconds": {"type": "integer", "minimum": 1, "default": 1800}
		  }
		},
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["driver", "dsn"],
          "properties": {
            "driver": {
              "type": "string",
              "enum": ["mysql", "postgres"]
            },
            "dsn": {
              "type": "string",
              "minLength": 1
            },
            "max_open_conns": {
              "type": "integer",
              "minimum": 1,
              "default": 100
            },
            "max_idle_conns": {
              "type": "integer",
              "minimum": 1,
              "default": 10
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "backend": {"const": "gorm"}
            },
            "required": ["backend"]
          },
          "then": {
            "required": ["database"]
          }
        }
      ]
    }
  }
}
