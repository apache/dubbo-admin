{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dubbo-admin.ai/schema/memory.schema.json",
  "title": "Memory Component Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "spec"],
  "properties": {
    "type": {
      "const": "memory"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_messages": {
          "type": "integer",
          "minimum": 1,
          "default": 20,
          "description": "Maximum number of messages per session (user + assistant total)"
        }
      }
    }
  }
}
